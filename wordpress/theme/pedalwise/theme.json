{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "1200px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "bg", "name": "Page background", "color": "#f7faf8" },
				{ "slug": "alt", "name": "Alternate background", "color": "#eef5f0" },
				{ "slug": "card", "name": "Card and header", "color": "#ffffff" },
				{ "slug": "tint", "name": "Green tint", "color": "#e6f3ea" },
				{ "slug": "ink", "name": "Text", "color": "#1b2a22" },
				{ "slug": "muted", "name": "Muted text", "color": "#46584e" },
				{ "slug": "green", "name": "Pedalwise green", "color": "#1b8656" },
				{ "slug": "green-text", "name": "Green text and links", "color": "#177a4c" },
				{ "slug": "price", "name": "Price green", "color": "#1e8e5a" },
				{ "slug": "orange", "name": "Orange (WhatsApp buttons)", "color": "#f28c28" },
				{ "slug": "on-orange", "name": "Text on orange", "color": "#1b2a22" },
				{ "slug": "banner", "name": "Banner green", "color": "#1b8656" },
				{ "slug": "footer", "name": "Footer", "color": "#1b2a22" },
				{ "slug": "footer-text", "name": "Footer text", "color": "#e8f0eb" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			]
		},
		"typography": {
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Inter-latin-variable.woff2" ]
						}
					]
				}
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--bg)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontSize": "18px", "lineHeight": "1.5" },
		"spacing": { "blockGap": "0" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--green-text)" } },
			"heading": { "typography": { "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.015em" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
